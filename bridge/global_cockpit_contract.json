      "session_id"
    ],
    "/api/deliverables": [],
    "/api/fs/dirs": [
      "path"
    ],
    "/api/quotas": [],
    "/portrait": [
      "name",
      "hi",
      "style"
    ]
  },
  "websocket": {
    "path": "/ws",
    "upgrade": "shared Admission.network(websocket=True)のみ。Host/Origin必須・capabilityfile存在を確認、アプリ状態に触れない。",
    "first_frame_schema": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "version",
        "capability"
      ],
      "properties": {
        "type": {
          "const": "authenticate"
        },
        "version": {
          "const": 1
        },
        "capability": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{43}$"
        }
      }
    },
    "authenticated_schema": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "version"
      ],
      "properties": {
        "type": {
          "const": "authenticated"
        },
        "version": {
          "const": 1
        }
      }
    },
    "deadline_seconds": 5,
    "maximum_utf8_bytes": 1024,
    "before_auth": "no sessions/list/snapshot/refresher/manager/client membership/attach/input/output/usage push。protocol PING/PONG/close以外送らない。invalid/timeout→close4401 generic。",
    "after_auth": "authenticate→authenticated→既存sessions/refresher/dispatch。再接続ごとに認証。2回目authenticate拒否。Lockでclose、unlock前の自動reconnect無し。capability rotationは両server restartを必要とし、WSの別session ledgerは持たない。"
  },
  "network_assets": [
