      "limit",
      "cursor",
      "query"
    ],
    "/api/mail/message": [
      "view_as_agent_id",
      "id"
    ],
    "/api/mail/conversation": [
      "view_as_agent_id",
      "message_id",
      "limit",
      "cursor"
    ],
    "/api/mail/legacy-label": [
      "view_as_agent_id",
      "label",
      "limit",
      "cursor"
    ],
    "/api/messages-since": [
      "view_as_agent_id",
      "after_id",
      "limit",
